{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ss-collections-preview",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ss-collections-preview-db",
      "database_id": "7a55254c-904a-471b-8d5e-6bfadcfcf204"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "ss-collections-preview-files"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "AI"
  }
}
